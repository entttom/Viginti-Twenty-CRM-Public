          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” segnata come completata. La modifica verrà sincronizzata quando Viginti sarà di nuovo online."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” gemarkeerd als voltooid. De wijziging wordt gesynchroniseerd zodra Viginti weer online is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
