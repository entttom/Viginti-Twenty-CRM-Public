    "settings.meetingPrep.followUp.hint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bietet nach einem Termin mit CRM-Kontakten an, eine Notiz oder Folgeaufgabe zu erfassen – auf der Startseite und per Mitteilung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
