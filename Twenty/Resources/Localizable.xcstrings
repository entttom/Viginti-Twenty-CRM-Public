    "meetingPrep.explainer.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Sie auf Ihren nächsten Termin vorzubereiten, liest Viginti die Termine der nächsten 24 Stunden auf diesem Gerät. Die E-Mail-Adressen der Teilnehmer werden mit den Kontakten auf Ihrem Twenty-Server abgeglichen. Titel, Zeiten, Notizen und andere Kalenderinhalte bleiben auf diesem Gerät und werden nie verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To prepare you for your next meeting, Viginti reads the events of the next 24 hours on this device. The participants' email addresses are matched with the contacts on your Twenty server. Titles, times, notes and other calendar contents stay on this device and are never changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para prepararte para tu próxima reunión, Viginti lee en este dispositivo los eventos de las próximas 24 horas. Las direcciones de correo de los participantes se comparan con los contactos de tu servidor de Twenty. Los títulos, horas, notas y demás contenido del calendario permanecen en este dispositivo y nunca se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vous préparer à votre prochaine réunion, Viginti lit sur cet appareil les événements des prochaines 24 heures. Les adresses e-mail des participants sont comparées aux contacts de votre serveur Twenty. Les titres, horaires, notes et autres contenus du calendrier restent sur cet appareil et ne sont jamais modifiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per preparare la prossima riunione, Viginti legge su questo dispositivo gli eventi delle prossime 24 ore. Gli indirizzi e-mail dei partecipanti vengono confrontati con i contatti sul server Twenty. Titoli, orari, note e altri contenuti del calendario restano su questo dispositivo e non vengono mai modificati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om u voor te bereiden op uw volgende afspraak leest Viginti op dit apparaat de afspraken van de komende 24 uur. De e-mailadressen van de deelnemers worden vergeleken met de contacten op uw Twenty-server. Titels, tijden, notities en andere agenda-inhoud blijven op dit apparaat en worden nooit gewijzigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para preparar você para a próxima reunião, o Viginti lê neste dispositivo os eventos das próximas 24 horas. Os endereços de e-mail dos participantes são comparados com os contatos do seu servidor do Twenty. Títulos, horários, notas e outros conteúdos do calendário ficam neste dispositivo e nunca são alterados."
          }
        }
      }
    },
    "meetingPrep.explainer.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminvorbereitung"
