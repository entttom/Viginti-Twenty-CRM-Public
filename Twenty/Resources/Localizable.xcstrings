    "settings.callFollowUp.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bietet nach einem Anruf, den Sie in Viginti gestartet haben, an, eine Notiz zu schreiben, eine Sprachnotiz aufzunehmen oder eine Folgeaufgabe zu erstellen. Erkannt werden nur Anrufe, die in Viginti gestartet wurden; Telefonnummern werden nie ausgelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a call you started from Viginti, offers to write a note, record a voice note or create a follow-up task. Only calls started in Viginti are recognized; phone numbers are never read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de una llamada iniciada desde Viginti, ofrece escribir una nota, grabar una nota de voz o crear una tarea de seguimiento. Solo se reconocen las llamadas iniciadas en Viginti; los números de teléfono nunca se leen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un appel lancé depuis Viginti, propose d’écrire une note, d’enregistrer une note vocale ou de créer une tâche de relance. Seuls les appels lancés dans Viginti sont reconnus ; les numéros de téléphone ne sont jamais lus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo una chiamata avviata da Viginti, propone di scrivere una nota, registrare una nota vocale o creare un'attività di follow-up. Vengono riconosciute solo le chiamate avviate in Viginti; i numeri di telefono non vengono mai letti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biedt na een gesprek dat u vanuit Viginti hebt gestart aan om een notitie te schrijven, een spraaknotitie op te nemen of een opvolgtaak aan te maken. Alleen gesprekken die in Viginti zijn gestart worden herkend; telefoonnummers worden nooit gelezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de uma chamada iniciada no Viginti, oferece a opção de escrever uma nota, gravar uma nota de voz ou criar uma tarefa de acompanhamento. Somente as chamadas iniciadas no Viginti são reconhecidas; os números de telefone nunca são lidos."
          }
        }
      }
    },
