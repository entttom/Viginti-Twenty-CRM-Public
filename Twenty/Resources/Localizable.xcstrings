    "settings.meetingPrep.denied" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti kann Ihren Kalender nicht lesen. Erlauben Sie Viginti in der Einstellungen-App den vollen Kalenderzugriff, um die Terminvorbereitung zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti cannot read your calendar. Allow full calendar access for Viginti in the Settings app to use meeting preparation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti no puede leer tu calendario. Permite el acceso completo al calendario para Viginti en la app Ajustes para usar la preparación de reuniones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti ne peut pas lire votre calendrier. Autorisez l’accès complet au calendrier pour Viginti dans l’app Réglages pour utiliser la préparation des réunions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti non può leggere il calendario. Per usare la preparazione delle riunioni, consentire a Viginti l'accesso completo al calendario nell'app Impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti kan uw agenda niet lezen. Sta volledige agendatoegang voor Viginti toe in de app Instellingen om afspraakvoorbereiding te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti não consegue ler seu calendário. Permita o acesso total ao calendário para o Viginti no app Ajustes para usar a preparação para reuniões."
          }
        }
      }
    },
    "settings.meetingPrep.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Ihren nächsten Termin auf der Startseite mit passenden CRM-Kontakten, deren offenen Aufgaben, letzter Notiz und offenen Verkaufschancen. Termine werden nur auf diesem Gerät gelesen und nie verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your next meeting on Home with matching CRM contacts, their open tasks, last note and open opportunities. Events are read on this device only and never changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra tu próxima reunión en Inicio con los contactos del CRM coincidentes, sus tareas abiertas, la última nota y las oportunidades abiertas. Los eventos se leen solo en este dispositivo y nunca se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche votre prochaine réunion sur l’accueil avec les contacts CRM correspondants, leurs tâches ouvertes, leur dernière note et leurs opportunités en cours. Les événements sont lus uniquement sur cet appareil et jamais modifiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra nella Home la prossima riunione con i contatti del CRM corrispondenti, le loro attività aperte, l'ultima nota e le opportunità aperte. Gli eventi vengono letti solo su questo dispositivo e non vengono mai modificati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont uw volgende afspraak op Start met bijbehorende CRM-contacten, hun open taken, laatste notitie en open kansen. Afspraken worden alleen op dit apparaat gelezen en nooit gewijzigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra sua próxima reunião no Início com os contatos do CRM correspondentes, suas tarefas em aberto, a última nota e as oportunidades em aberto. Os eventos são lidos apenas neste dispositivo e nunca são alterados."
          }
        }
      }
    },
