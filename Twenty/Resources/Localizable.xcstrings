    "opportunity.pipeline.unavailableFilters" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter für nur eigene Chancen und ohne nächste Aktivität benötigen Current-User- und Opportunity-Aktivitätsdaten, die lokal noch nicht verfügbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Owned-only and no-next-activity filters need current-user and opportunity activity data that is not available locally yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los filtros de solo propias y de sin próxima actividad necesitan datos del usuario actual y de la actividad de las oportunidades que aún no están disponibles localmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les filtres « propriétaire uniquement » et « sans prochaine activité » nécessitent l’utilisateur actuel et des données d’activité des opportunités qui ne sont pas encore disponibles en local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I filtri \"solo proprie\" e \"senza prossima attività\" richiedono dati sull'utente corrente e sull'attività delle opportunità, non ancora disponibili in locale."
          }
        },
