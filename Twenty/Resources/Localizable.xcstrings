        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota era lunga: è stata riassunta solo la prima parte, il resto resta come è stato scritto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De notitie was lang: alleen het eerste deel is samengevat, de rest blijft zoals geschreven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nota era longa: apenas a primeira parte foi resumida; o restante foi mantido como escrito."
          }
        }
      }
    },
