      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor ein neuer Kontakt oder ein neues Unternehmen erstellt wird, sucht Viginti in Ihrem Workspace nach bestehenden Einträgen mit gleicher E-Mail, Telefonnummer, Domain oder gleichem Namen."
