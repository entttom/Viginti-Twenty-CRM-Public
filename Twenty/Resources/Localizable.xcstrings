    "settings.calendar.updateLinkedEvents.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, aktualisieren Änderungen an Aufgabentitel und Fälligkeit lokal verknüpfte Kalenderereignisse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, task title and due date changes update locally linked calendar events."
          }
