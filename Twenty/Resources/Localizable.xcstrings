          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Sie auf Ihren nächsten Termin vorzubereiten, liest Viginti die Termine der nächsten 24 Stunden auf diesem Gerät und ordnet die Teilnehmer Ihren CRM-Kontakten zu. Kalenderdaten werden weder hochgeladen noch verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To prepare you for your next meeting, Viginti reads the events of the next 24 hours on this device and matches participants with your CRM contacts. Calendar data is not uploaded or changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para prepararte para tu próxima reunión, Viginti lee los eventos de las próximas 24 horas en este dispositivo y relaciona los participantes con tus contactos del CRM. Los datos del calendario no se suben ni se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vous préparer à votre prochaine réunion, Viginti lit sur cet appareil les événements des prochaines 24 heures et associe les participants à vos contacts CRM. Les données du calendrier ne sont ni envoyées ni modifiées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per preparare la prossima riunione, Viginti legge su questo dispositivo gli eventi delle prossime 24 ore e abbina i partecipanti ai contatti del CRM. I dati del calendario non vengono caricati né modificati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om u voor te bereiden op uw volgende afspraak leest Viginti de afspraken van de komende 24 uur op dit apparaat en koppelt de deelnemers aan uw CRM-contacten. Agendagegevens worden niet geüpload of gewijzigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para preparar você para a próxima reunião, o Viginti lê os eventos das próximas 24 horas neste dispositivo e relaciona os participantes com seus contatos do CRM. Os dados do calendário não são enviados nem alterados."
          }
        }
      }
    },
