    "meetingPrep.denied.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti kann Ihren Kalender nicht lesen, daher ist die Terminvorbereitung nicht verfügbar. Sie können Viginti in der Einstellungen-App den vollen Kalenderzugriff erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti cannot read your calendar, so meeting preparation is unavailable. You can allow full calendar access for Viginti in the Settings app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti no puede leer tu calendario, por lo que la preparación de reuniones no está disponible. Puedes permitir el acceso completo al calendario para Viginti en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti ne peut pas lire votre calendrier : la préparation des réunions est donc indisponible. Vous pouvez autoriser l’accès complet au calendrier pour Viginti dans l’app Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti non può leggere il calendario, quindi la preparazione delle riunioni non è disponibile. È possibile consentire a Viginti l'accesso completo al calendario nell'app Impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti kan uw agenda niet lezen, dus de voorbereiding op afspraken is niet beschikbaar. U kunt volledige agendatoegang voor Viginti toestaan in de app Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti não consegue ler seu calendário, portanto a preparação para reuniões não está disponível. Você pode permitir acesso total ao calendário para o Viginti no app Ajustes."
          }
        }
      }
    },
