    "meetingFollowUp.dontLog.confirmMessage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Notiz, Ihr Diktat und die Folgeaufgabe werden verworfen, und dieser Termin wird nicht mehr angeboten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your note, dictation and follow-up task will be discarded, and this meeting won't be offered again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descartarán tu nota, tu dictado y la tarea de seguimiento, y esta reunión no se volverá a ofrecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre note, votre dictée et la tâche de relance seront supprimées, et cette réunion ne sera plus proposée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota, la dettatura e l'attività di follow-up verranno eliminate e questa riunione non verrà più proposta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw notitie, dictaat en opvolgtaak worden weggegooid en deze afspraak wordt niet meer aangeboden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua nota, seu ditado e a tarefa de acompanhamento serão descartados, e esta reunião não será oferecida novamente."
          }
        }
      }
    },
