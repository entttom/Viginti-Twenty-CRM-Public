    "emailCompose.error.offline" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind offline. Die E-Mail wurde als Entwurf behalten – senden Sie sie, sobald Sie wieder online sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're offline. The email was kept as a draft — send it once you're back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás sin conexión. El correo se ha guardado como borrador: envíalo cuando vuelvas a estar en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne. L’e-mail a été conservé comme brouillon — envoyez-le quand vous serez de nouveau en ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo è offline. L'e-mail è stata conservata come bozza: inviarla una volta tornati online."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U bent offline. De e-mail is als concept bewaard – verstuur deze zodra u weer online bent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está offline. O e-mail foi mantido como rascunho — envie-o quando estiver online novamente."
          }
        }
      }
    },
    "emailCompose.error.permission" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Twenty-Rolle darf keine E-Mails senden. Bitte einen Admin um die Berechtigung „E-Mail senden“ oder verwende die Mail-App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Twenty role is not allowed to send emails. Ask an admin for the “Send email” permission, or use the Mail app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu rol de Twenty no puede enviar correos. Pide a un administrador el permiso «Enviar correo» o usa la app Mail."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre rôle Twenty n’est pas autorisé à envoyer des e-mails. Demandez l’autorisation « Envoyer des e-mails » à un administrateur, ou utilisez l’app Mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ruolo Twenty assegnato non consente di inviare e-mail. Chiedere a un amministratore l'autorizzazione “Invia e-mail” oppure usare l'app Mail."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw Twenty-rol mag geen e-mails versturen. Vraag een beheerder om de machtiging “E-mail versturen”, of gebruik de Mail-app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua função no Twenty não tem permissão para enviar e-mails. Peça a um administrador a permissão “Enviar e-mail” ou use o app Mail."
          }
        }
      }
    },
