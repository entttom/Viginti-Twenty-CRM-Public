    "workspaces.remove.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden auf diesem Gerät von diesem Workspace abgemeldet. Zwischengespeicherte Datensätze und nicht synchronisierte Änderungen bleiben auf diesem Gerät, sofern Sie sie nicht löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will be signed out of this workspace on this device. Cached records and unsynced changes stay on this device unless you delete them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará la sesión de este espacio de trabajo en este dispositivo. Los registros en caché y los cambios sin sincronizar permanecen en este dispositivo salvo que los elimines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez déconnecté de cet espace de travail sur cet appareil. Les enregistrements en cache et les modifications non synchronisées restent sur cet appareil, sauf si vous les supprimez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà effettuata l'uscita da questo workspace su questo dispositivo. I record nella cache e le modifiche non sincronizzate restano su questo dispositivo, a meno che non vengano eliminati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U wordt op dit apparaat uitgelogd bij deze workspace. Gecachete records en niet-gesynchroniseerde wijzigingen blijven op dit apparaat, tenzij u ze verwijdert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você será desconectado deste espaço de trabalho neste dispositivo. Os registros em cache e as alterações não sincronizadas permanecem neste dispositivo, a menos que você os apague."
          }
        }
      }
    },
