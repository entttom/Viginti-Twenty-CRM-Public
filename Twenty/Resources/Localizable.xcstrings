    "subscription.section.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monats- und Jahresabo verlängern sich automatisch über Ihren Apple-Account. Sie können jederzeit über „Abonnement verwalten“ kündigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly and yearly plans renew automatically via your Apple account. You can cancel anytime via “Manage Subscription”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planes mensual y anual se renuevan automáticamente a través de tu cuenta de Apple. Puedes cancelar en cualquier momento desde «Gestionar suscripción»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les formules mensuelle et annuelle se renouvellent automatiquement via votre compte Apple. Vous pouvez résilier à tout moment via « Gérer l’abonnement »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I piani mensili e annuali si rinnovano automaticamente tramite l'account Apple. È possibile annullare in qualsiasi momento da “Gestisci abbonamento”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maand- en jaarabonnementen worden automatisch verlengd via uw Apple-account. U kunt op elk moment opzeggen via “Beheer abonnement”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os planos mensal e anual são renovados automaticamente pela sua conta Apple. Você pode cancelar a qualquer momento em “Gerenciar assinatura”."
          }
        }
      }
    },
