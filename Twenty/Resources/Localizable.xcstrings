    "workspaces.footer.free" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wechsel zwischen Workspaces ist Teil von Viginti Pro. Ihr aktiver Workspace bleibt voll nutzbar, und die anderen behalten ihre Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching between workspaces is part of Viginti Pro. Your active workspace stays fully usable, and the others keep their data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar entre espacios de trabajo forma parte de Viginti Pro. Tu espacio de trabajo activo sigue siendo totalmente utilizable y los demás conservan sus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le changement d’espace de travail fait partie de Viginti Pro. Votre espace de travail actif reste pleinement utilisable et les autres conservent leurs données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il passaggio tra workspace fa parte di Viginti Pro. Il workspace attivo resta pienamente utilizzabile e gli altri conservano i propri dati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wisselen tussen workspaces maakt deel uit van Viginti Pro. Uw actieve workspace blijft volledig bruikbaar en de andere behouden hun gegevens."
          }
