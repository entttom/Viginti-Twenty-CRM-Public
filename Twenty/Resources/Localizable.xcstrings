    "settings.callerID.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruft ein CRM-Kontakt an, zeigt Ihr iPhone Name und Firma an. Viginti verwendet dafür die auf diesem Gerät gespeicherten Telefonnummern der Kontakte des aktiven Workspace. Wer Sie anruft, wird nie an Viginti oder Ihren Twenty-Server gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a CRM contact calls, your iPhone shows their name and company. Viginti uses the phone numbers of the active workspace's contacts stored on this device. Who calls you is never sent to Viginti or your Twenty server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando te llama un contacto del CRM, tu iPhone muestra su nombre y su empresa. Viginti usa los números de teléfono de los contactos del espacio de trabajo activo guardados en este dispositivo. Quién te llama nunca se envía a Viginti ni a tu servidor de Twenty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand un contact CRM vous appelle, votre iPhone affiche son nom et son entreprise. Viginti utilise les numéros de téléphone des contacts de l’espace de travail actif stockés sur cet appareil. L’identité de vos appelants n’est jamais envoyée à Viginti ni à votre serveur Twenty."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando chiama un contatto CRM, iPhone mostra il nome e l'azienda. Viginti usa i numeri di telefono dei contatti del workspace attivo memorizzati su questo dispositivo. Chi chiama non viene mai inviato a Viginti o al server Twenty."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als een CRM-contact belt, toont uw iPhone de naam en het bedrijf. Viginti gebruikt hiervoor de op dit apparaat opgeslagen telefoonnummers van de contacten in de actieve workspace. Wie u belt, wordt nooit naar Viginti of uw Twenty-server verstuurd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um contato do CRM liga, o iPhone mostra o nome e a empresa dele. O Viginti usa os números de telefone dos contatos do espaço de trabalho ativo armazenados neste dispositivo. Quem liga para você nunca é enviado ao Viginti nem ao seu servidor do Twenty."
          }
        }
      }
    },
    "settings.callerID.appLockHint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App-Sperre kann die Anruferkennung nicht verbergen: Während Ihr iPhone klingelt, erscheint der Name auch auf dem Sperrbildschirm. Bei aktiver App-Sperre wird nur der Name angezeigt, nicht die Firma. Schalten Sie die Anruferkennung aus, um die Namen zu verbergen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Lock cannot hide caller ID: while your iPhone rings, the name also appears on the Lock Screen. With App Lock on, only the name is shown, not the company. Turn caller ID off to hide the names."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo de la app no puede ocultar la identificación de llamadas: mientras suena el iPhone, el nombre también aparece en la pantalla bloqueada. Con el bloqueo de la app activado, solo se muestra el nombre, no la empresa. Desactiva la identificación de llamadas para ocultar los nombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verrouillage de l’app ne peut pas masquer l’identification de l’appelant : pendant que votre iPhone sonne, le nom apparaît aussi sur l’écran verrouillé. Avec le verrouillage de l’app activé, seul le nom est affiché, pas l’entreprise. Désactivez l’identification de l’appelant pour masquer les noms."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco app non può nascondere l'ID chiamante: mentre iPhone squilla, il nome appare anche sulla schermata di blocco. Con il blocco app attivo viene mostrato solo il nome, non l'azienda. Disattivare l'ID chiamante per nascondere i nomi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appvergrendeling kan de nummerweergave niet verbergen: terwijl uw iPhone overgaat, verschijnt de naam ook op het toegangsscherm. Met appvergrendeling aan wordt alleen de naam getoond, niet het bedrijf. Schakel de nummerweergave uit om de namen te verbergen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bloqueio do App não pode ocultar a identificação de chamadas: enquanto o iPhone toca, o nome também aparece na Tela Bloqueada. Com o Bloqueio do App ativado, apenas o nome é exibido, não a empresa. Desative a identificação de chamadas para ocultar os nomes."
          }
        }
      }
    },
    "settings.callerID.paused" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert: Die Anruferkennung ist Teil von Viginti Pro. Ihre CRM-Kontakte werden bei Anrufen nicht angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paused: caller ID is part of Viginti Pro. Your CRM contacts are not shown during calls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa: la identificación de llamadas forma parte de Viginti Pro. Tus contactos del CRM no se muestran durante las llamadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause : l’identification de l’appelant fait partie de Viginti Pro. Vos contacts CRM ne sont pas affichés lors des appels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa: l'ID chiamante fa parte di Viginti Pro. I contatti CRM non vengono mostrati durante le chiamate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gepauzeerd: nummerweergave maakt deel uit van Viginti Pro. Uw CRM-contacten worden bij oproepen niet getoond."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausado: a identificação de chamadas faz parte do Viginti Pro. Seus contatos do CRM não são mostrados durante as chamadas."
          }
        }
      }
    },
