      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie ein Viginti-Widget hinzu, um die heutigen Aufgaben auf einen Blick zu sehen: Halten Sie den Home-Bildschirm gedrückt und tippen Sie auf „Bearbeiten“."
