    "richText.readOnly.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Text enthält Formatierungen, die die App nicht ohne Verlust bearbeiten kann. Sie können ihn hier lesen und im Web bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This text uses formatting the app can't edit without losing content. You can read it here and edit it on the web."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este texto usa un formato que la app no puede editar sin perder contenido. Puedes leerlo aquí y editarlo en la web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce texte utilise une mise en forme que l’app ne peut pas modifier sans perte de contenu. Vous pouvez le lire ici et le modifier sur le Web."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo testo usa una formattazione che l'app non può modificare senza perdere contenuti. È possibile leggerlo qui e modificarlo sul web."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze tekst gebruikt opmaak die de app niet kan wijzigen zonder inhoud te verliezen. U kunt deze hier lezen en op het web wijzigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este texto usa uma formatação que o app não consegue editar sem perder conteúdo. Você pode lê-lo aqui e editá-lo na web."
          }
        }
      }
    },
