    "settings.meetingPrep.liveActivity.hint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt das Meeting ab einer Stunde vor Beginn mit den passenden Kontakten auf dem Sperrbildschirm und in der Dynamic Island. Startet, während Viginti geöffnet ist."
          }
        },
        "en" : {
