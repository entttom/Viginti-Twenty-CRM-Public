        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datensatz wurde auf dem Server angelegt, aber seine ID konnte nicht gespeichert werden. Er wird ohne Duplikat abgeglichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The record was created on the server, but saving its ID failed. It will be reconciled without creating a duplicate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro se ha creado en el servidor, pero ha fallado el guardado de su ID. Se conciliará sin crear un duplicado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement a été créé sur le serveur, mais l’enregistrement de son ID a échoué. Il sera rapproché sans créer de doublon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il record è stato creato sul server, ma il salvataggio del suo ID non è riuscito. Verrà riconciliato senza creare un duplicato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het record is op de server aangemaakt, maar het bewaren van de ID is mislukt. Het wordt afgestemd zonder duplicaat aan te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro foi criado no servidor, mas falhou ao salvar seu ID. Ele será reconciliado sem criar uma duplicata."
          }
        }
      }
    },
