            "value" : "Has cambiado de %@. Elige si quieres eliminar de este dispositivo sus datos en caché."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez quitté %@. Choisissez de supprimer ou non ses données en cache de cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
