    "calendar.accessDenied.settingsExplanation" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti benötigt vollen Zugriff auf Ihre Kalender, um Aufgaben als Termine einzutragen. Sie können dies in der Einstellungen-App unter Viginti > Kalender erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti needs full access to your calendars to add tasks as events. You can allow this in the Settings app under Viginti > Calendars."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti necesita acceso completo a tus calendarios para añadir tareas como eventos. Puedes permitirlo en la app Ajustes, en Viginti > Calendarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti a besoin d’un accès complet à vos calendriers pour ajouter les tâches comme événements. Vous pouvez l’autoriser dans l’app Réglages sous Viginti > Calendriers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti richiede l'accesso completo ai calendari per aggiungere le attività come eventi. È possibile consentirlo in Impostazioni > Viginti > Calendari."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti heeft volledige toegang tot uw agenda's nodig om taken als afspraken toe te voegen. U kunt dit toestaan in de app Instellingen onder Viginti > Agenda's."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti precisa de acesso total aos seus calendários para adicionar tarefas como eventos. Você pode permitir isso no app Ajustes, em Viginti > Calendários."
          }
        }
      }
    },
