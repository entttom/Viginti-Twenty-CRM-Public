    "meetingFollowUp.ai.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft auf diesem Gerät. Bringt die Notiz in Form und schlägt eine Folgeaufgabe vor; prüfe sie vor dem Speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs on this device. Tidies up the note and suggests a follow-up task; review it before saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta en este dispositivo. Ordena la nota y sugiere una tarea de seguimiento; revísala antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’exécute sur cet appareil. Met en forme la note et suggère une tâche de relance ; vérifiez-la avant d’enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene eseguito su questo dispositivo. Riordina la nota e suggerisce un'attività di follow-up; controllarla prima di salvare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt op dit apparaat. Brengt de notitie op orde en stelt een opvolgtaak voor; controleer deze vóór het bewaren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É executado neste dispositivo. Organiza a nota e sugere uma tarefa de acompanhamento; revise-a antes de salvar."
          }
        }
      }
    },
    "meetingFollowUp.ai.partial" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notiz war lang: Nur der erste Teil wurde zusammengefasst, der Rest bleibt wie geschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The note was long: only its first part was summarized, the rest is kept as written."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota era larga: solo se ha resumido la primera parte; el resto se mantiene tal como se escribió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La note était longue : seule sa première partie a été résumée, le reste est conservé tel quel."
          }
