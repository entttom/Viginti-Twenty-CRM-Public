    "map.nearby.denied.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti darf Ihren Standort nicht verwenden, daher ist die Sortierung nach Entfernung nicht verfügbar. Sie können Viginti den Standortzugriff in der Einstellungen-App erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti is not allowed to use your location, so sorting by distance is unavailable. You can allow location access for Viginti in the Settings app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti no tiene permiso para usar tu ubicación, por lo que la ordenación por distancia no está disponible. Puedes permitir el acceso a la ubicación para Viginti en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti n’est pas autorisé à utiliser votre position, le tri par distance est donc indisponible. Vous pouvez autoriser l’accès à la position pour Viginti dans l’app Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti non è autorizzato a usare la posizione, quindi l'ordinamento per distanza non è disponibile. È possibile consentire a Viginti l'accesso alla posizione nell'app Impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti mag uw locatie niet gebruiken, dus sorteren op afstand is niet beschikbaar. U kunt Viginti toegang tot uw locatie geven in de app Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti não tem permissão para usar a sua localização, portanto a ordenação por distância não está disponível. Você pode permitir o acesso à localização para o Viginti no app Ajustes."
          }
