          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti kan uw agenda niet lezen. Sta volledige agendatoegang voor Viginti toe in de app Instellingen om afspraakvoorbereiding te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti não consegue ler seu calendário. Permita o acesso total ao calendário para o Viginti no app Ajustes para usar a preparação para reuniões."
          }
        }
      }
    },
    "settings.meetingPrep.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Ihren nächsten Termin auf der Startseite mit passenden CRM-Kontakten, deren offenen Aufgaben, letzter Notiz und offenen Verkaufschancen. Die E-Mail-Adressen der Teilnehmer werden mit Ihrem Twenty-Server abgeglichen; alle anderen Kalenderinhalte bleiben auf diesem Gerät und werden nie verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your next meeting on Home with matching CRM contacts, their open tasks, last note and open opportunities. Participants' email addresses are matched with your Twenty server; all other calendar contents stay on this device and are never changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra tu próxima reunión en Inicio con los contactos del CRM coincidentes, sus tareas abiertas, la última nota y las oportunidades abiertas. Las direcciones de correo de los participantes se comparan con tu servidor de Twenty; el resto del contenido del calendario permanece en este dispositivo y nunca se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche votre prochaine réunion sur l’accueil avec les contacts CRM correspondants, leurs tâches ouvertes, leur dernière note et leurs opportunités en cours. Les adresses e-mail des participants sont comparées avec votre serveur Twenty ; tous les autres contenus du calendrier restent sur cet appareil et ne sont jamais modifiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra nella Home la prossima riunione con i contatti del CRM corrispondenti, le loro attività aperte, l'ultima nota e le opportunità aperte. Gli indirizzi e-mail dei partecipanti vengono confrontati con il server Twenty; tutti gli altri contenuti del calendario restano su questo dispositivo e non vengono mai modificati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont uw volgende afspraak op Start met bijbehorende CRM-contacten, hun open taken, laatste notitie en open kansen. De e-mailadressen van de deelnemers worden vergeleken met uw Twenty-server; alle andere agenda-inhoud blijft op dit apparaat en wordt nooit gewijzigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra sua próxima reunião no Início com os contatos do CRM correspondentes, suas tarefas em aberto, a última nota e as oportunidades em aberto. Os endereços de e-mail dos participantes são comparados com seu servidor do Twenty; todo o restante do conteúdo do calendário fica neste dispositivo e nunca é alterado."
          }
        }
      }
    },
