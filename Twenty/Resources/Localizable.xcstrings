    "connection.formerWorkspace.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben den Workspace %@ gewechselt. Wählen Sie, ob dessen zwischengespeicherte Daten von diesem Gerät entfernt werden sollen."
          }
        },
