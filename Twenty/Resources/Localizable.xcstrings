    "merge.keep.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo sich die Datensätze unterscheiden, gelten seine Werte; leere Felder werden aus den anderen ergänzt. Notizen, Aufgaben, Verkaufschancen, Dateien und die Timeline wandern zu ihm. Die anderen Datensätze werden gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its values win where the records differ; empty fields are filled from the others. Notes, tasks, opportunities, files and the timeline move to it. The other records are deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus valores prevalecen donde los registros difieren; los campos vacíos se completan con los de los demás. Las notas, tareas, oportunidades, archivos y la cronología pasan a este registro. Los demás registros se eliminan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses valeurs l’emportent là où les enregistrements diffèrent ; les champs vides sont complétés à partir des autres. Les notes, tâches, opportunités, fichiers et la chronologie y sont transférés. Les autres enregistrements sont supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi valori prevalgono dove i record differiscono; i campi vuoti vengono completati con quelli degli altri. Note, attività, opportunità, file e cronologia vengono trasferiti a questo record. Gli altri record vengono eliminati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar de records verschillen, gelden de waarden van dit record; lege velden worden aangevuld uit de andere. Notities, taken, kansen, bestanden en de tijdlijn worden hiernaartoe verplaatst. De andere records worden verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores dele prevalecem onde os registros diferem; os campos vazios são preenchidos com os dos outros. Notas, tarefas, oportunidades, arquivos e a linha do tempo passam para ele. Os outros registros são apagados."
          }
        }
      }
    },
