            "value" : "Avant de créer un contact ou une entreprise, Viginti recherche dans votre espace de travail des enregistrements existants ayant le même e-mail, numéro de téléphone, domaine ou nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di creare un nuovo contatto o una nuova azienda, Viginti cerca nel workspace record esistenti con la stessa e-mail, lo stesso numero di telefono, dominio o nome."
          }
        },
        "nl" : {
          "stringUnit" : {
