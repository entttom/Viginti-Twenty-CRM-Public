    "sync.blocked.waitingFor" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf eine frühere Änderung an „%@“, die nicht synchronisiert werden konnte. Wiederholen oder verwerfen Sie zuerst diese Änderung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for an earlier change to “%@” that could not be synced. Retry or discard that change first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando un cambio anterior en «%@» que no se ha podido sincronizar. Reintenta o descarta primero ese cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente d’une modification antérieure de « %@ » qui n’a pas pu être synchronisée. Réessayez ou supprimez d’abord cette modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di una modifica precedente a “%@” che non è stato possibile sincronizzare. Riprovare o eliminare prima quella modifica."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht op een eerdere wijziging aan “%@” die niet kon worden gesynchroniseerd. Probeer die wijziging eerst opnieuw of gooi deze weg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando uma alteração anterior em “%@” que não pôde ser sincronizada. Tente novamente ou descarte essa alteração primeiro."
          }
        }
      }
    },
