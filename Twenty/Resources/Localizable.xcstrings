    "sync.localRepairFailed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Änderung ist auf dem Server angekommen, aber die lokalen Daten konnten nicht aktualisiert werden. Wiederholen Sie, um sie zu aktualisieren, oder verwerfen Sie die lokale Kopie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The change reached the server, but local data could not be refreshed. Retry to refresh it, or discard to drop the local copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cambio ha llegado al servidor, pero no se han podido actualizar los datos locales. Reintenta para actualizarlos o descarta la copia local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modification a atteint le serveur, mais les données locales n’ont pas pu être actualisées. Réessayez pour les actualiser, ou supprimez la copie locale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modifica ha raggiunto il server, ma non è stato possibile aggiornare i dati locali. Riprovare per aggiornarli oppure eliminare la copia locale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wijziging heeft de server bereikt, maar de lokale gegevens konden niet worden vernieuwd. Probeer het opnieuw om ze te vernieuwen, of gooi de lokale kopie weg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A alteração chegou ao servidor, mas os dados locais não puderam ser atualizados. Tente novamente para atualizá-los ou descarte a cópia local."
          }
        }
      }
    },
    "sync.unknownAction" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Änderung wurde von einer anderen Version von Viginti gespeichert und kann von dieser Version nicht synchronisiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This change was saved by a different version of Viginti and cannot be synced by this version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cambio lo guardó otra versión de Viginti y esta versión no puede sincronizarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette modification a été enregistrée par une autre version de Viginti et ne peut pas être synchronisée par cette version."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa modifica è stata salvata da un'altra versione di Viginti e non può essere sincronizzata da questa versione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze wijziging is bewaard door een andere versie van Viginti en kan door deze versie niet worden gesynchroniseerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta alteração foi salva por outra versão do Viginti e não pode ser sincronizada por esta versão."
          }
        }
      }
    },
    "sync.accountMismatch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Änderung wurde gemacht, während unter dieser Adresse ein anderes Konto angemeldet war. Sie wurde nicht gesendet. Wiederholen Sie, um sie mit dem aktuellen Konto zu senden, oder verwerfen Sie sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This change was made while another account was signed in at this address. It was not sent. Retry to send it with the current account, or discard it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cambio se hizo mientras otra cuenta tenía la sesión iniciada en esta dirección. No se ha enviado. Reintenta para enviarlo con la cuenta actual o descártalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette modification a été faite alors qu’un autre compte était connecté à cette adresse. Elle n’a pas été envoyée. Réessayez pour l’envoyer avec le compte actuel, ou supprimez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa modifica è stata effettuata mentre a questo indirizzo era connesso un altro account. Non è stata inviata. Riprovare per inviarla con l'account attuale oppure eliminarla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze wijziging is gemaakt terwijl op dit adres een ander account was ingelogd. Ze is niet verstuurd. Probeer het opnieuw om ze met het huidige account te versturen, of gooi ze weg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta alteração foi feita enquanto outra conta estava conectada neste endereço. Ela não foi enviada. Tente novamente para enviá-la com a conta atual ou descarte-a."
          }
        }
      }
    },
    "offline.storeRecovery.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti konnte seine Offline-Daten nicht öffnen und hat mit einem leeren Offline-Speicher begonnen. Noch nicht synchronisierte Änderungen wurden als Sicherung auf diesem Gerät aufbewahrt und nicht gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti could not open its offline data and started with an empty offline store. Changes that had not synced yet were kept in a backup on this device and were not sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti no ha podido abrir sus datos sin conexión y ha empezado con un almacén sin conexión vacío. Los cambios que aún no se habían sincronizado se han guardado en una copia de seguridad en este dispositivo y no se han enviado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti n’a pas pu ouvrir ses données hors ligne et a démarré avec un stockage hors ligne vide. Les modifications non encore synchronisées ont été conservées dans une sauvegarde sur cet appareil et n’ont pas été envoyées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti non è riuscito ad aprire i dati offline ed è partito con un archivio offline vuoto. Le modifiche non ancora sincronizzate sono state conservate in un backup su questo dispositivo e non sono state inviate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti kon de offline gegevens niet openen en is gestart met een lege offline opslag. Wijzigingen die nog niet waren gesynchroniseerd, zijn als reservekopie op dit apparaat bewaard en niet verstuurd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti não conseguiu abrir os dados offline e começou com um armazenamento offline vazio. As alterações ainda não sincronizadas foram mantidas em um backup neste dispositivo e não foram enviadas."
          }
        }
      }
    },
    "intent.completeTask.queued" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
