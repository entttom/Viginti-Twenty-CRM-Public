        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los cambios en el título y la fecha de vencimiento de las tareas actualizan los eventos de calendario vinculados localmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si activé, les modifications du titre et de l’échéance d’une tâche mettent à jour les événements de calendrier liés localement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
