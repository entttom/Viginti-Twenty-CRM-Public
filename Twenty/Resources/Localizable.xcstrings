    "map.nearby.explainer.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Unternehmen und Kontakte nach Entfernung zu sortieren, verwendet Viginti Ihren aktuellen Standort, während Sie die App nutzen. Ihr Standort wird nur auf diesem Gerät verwendet und weder gespeichert noch an Ihren Twenty-Server gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To sort companies and contacts by distance, Viginti uses your current location while you use the app. Your location is only used on this device and is not stored or sent to your Twenty server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ordenar las empresas y los contactos por distancia, Viginti usa tu ubicación actual mientras usas la app. Tu ubicación solo se usa en este dispositivo y no se guarda ni se envía a tu servidor de Twenty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour trier les entreprises et les contacts par distance, Viginti utilise votre position actuelle pendant que vous utilisez l’app. Votre position est utilisée uniquement sur cet appareil ; elle n’est ni enregistrée ni envoyée à votre serveur Twenty."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ordinare aziende e contatti in base alla distanza, Viginti usa la posizione attuale mentre si utilizza l'app. La posizione viene usata solo su questo dispositivo e non viene salvata né inviata al server Twenty."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om bedrijven en contacten op afstand te sorteren, gebruikt Viginti uw huidige locatie terwijl u de app gebruikt. Uw locatie wordt alleen op dit apparaat gebruikt en niet bewaard of naar uw Twenty-server verzonden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ordenar empresas e contatos por distância, o Viginti usa a sua localização atual enquanto você usa o app. A sua localização é usada somente neste dispositivo e não é armazenada nem enviada ao seu servidor Twenty."
          }
        }
      }
    },
