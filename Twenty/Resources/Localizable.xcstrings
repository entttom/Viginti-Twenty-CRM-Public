        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una reunión con contactos del CRM, ofrece registrar una nota o una tarea de seguimiento en Inicio y mediante una notificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après une réunion avec des contacts CRM, propose de rédiger une note ou une tâche de relance, sur l’accueil et par notification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo una riunione con contatti CRM, propone di registrare una nota o un'attività di follow-up nella Home e con una notifica."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biedt na een afspraak met CRM-contacten aan om een notitie of opvolgtaak vast te leggen, op Start en met een melding."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após uma reunião com contatos do CRM, oferece registrar uma nota ou uma tarefa de acompanhamento no Início e com uma notificação."
          }
        }
      }
    },
