    "fieldEditor.multi.footer.edit" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Eintrag ist der primäre. Tippen Sie auf „Bearbeiten“, um Einträge zu entfernen oder neu anzuordnen, oder halten Sie einen Eintrag gedrückt, um ihn zum primären zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first entry is the primary one. Tap Edit to remove or reorder entries, or touch and hold an entry to make it primary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera entrada es la principal. Toca Editar para eliminar o reordenar entradas, o mantén pulsada una entrada para convertirla en principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première entrée est l’entrée principale. Touchez Modifier pour supprimer ou réorganiser les entrées, ou maintenez le doigt sur une entrée pour la définir comme principale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prima voce è quella principale. Toccare Modifica per rimuovere o riordinare le voci, oppure tenere premuta una voce per impostarla come principale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het eerste item is het primaire. Tik op Wijzig om items te verwijderen of anders te ordenen, of houd een item ingedrukt om het primair te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A primeira entrada é a principal. Toque em Editar para remover ou reordenar entradas, ou mantenha uma entrada pressionada para torná-la principal."
          }
        }
      }
    },
