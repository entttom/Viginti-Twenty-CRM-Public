    "subscription.section.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monats- und Jahresabo verlängern sich automatisch über Ihren Apple-Account. Sie können jederzeit über „Abonnement verwalten“ kündigen."
          }
        },
        "en" : {
          "stringUnit" : {
