    "settings.calendar.updateLinkedEvents.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, aktualisieren Änderungen an Aufgabentitel und Fälligkeit lokal verknüpfte Kalenderereignisse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, task title and due date changes update locally linked calendar events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los cambios en el título y la fecha de vencimiento de las tareas actualizan los eventos de calendario vinculados localmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si activé, les modifications du titre et de l’échéance d’une tâche mettent à jour les événements de calendrier liés localement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
