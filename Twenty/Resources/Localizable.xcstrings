    "emailCompose.formattingHint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**fett**, *kursiv*, Zeilen mit „- “ am Anfang werden zur Liste. Links werden erkannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**bold**, *italic*, lines starting with “- ” become a list. Links are detected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**negrita**, *cursiva*; las líneas que empiezan por «- » se convierten en una lista. Los enlaces se detectan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**gras**, *italique*, les lignes commençant par « - » deviennent une liste. Les liens sont détectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**grassetto**, *corsivo*, le righe che iniziano con “- ” diventano un elenco. I link vengono riconosciuti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**vet**, *cursief*, regels die beginnen met “- ” worden een lijst. Links worden herkend."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**negrito**, *itálico*, linhas que começam com “- ” viram uma lista. Os links são detectados."
          }
        }
      }
    },
