    "notifications.explainer.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti kann Sie an fällige Aufgaben erinnern. Sie können dies jederzeit in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti can remind you when tasks are due. You can change this anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti puede recordarte cuándo vencen las tareas. Puedes cambiarlo en cualquier momento en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
