    "tips.keyboard.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie ⌘K, um von überall aus zu suchen, und ⌘N, um einen Eintrag anzulegen. Halten Sie ⌘ gedrückt, um alle Kurzbefehle zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press ⌘K to search from anywhere and ⌘N to create an item. Hold ⌘ to see all shortcuts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa ⌘K para buscar desde cualquier lugar y ⌘N para crear un elemento. Mantén pulsada ⌘ para ver todos los atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur ⌘K pour rechercher de n’importe où et sur ⌘N pour créer un élément. Maintenez ⌘ enfoncée pour voir tous les raccourcis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premere ⌘K per cercare da qualsiasi punto e ⌘N per creare un elemento. Tenere premuto ⌘ per vedere tutte le scorciatoie."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk op ⌘K om overal te zoeken en op ⌘N om een item aan te maken. Houd ⌘ ingedrukt om alle sneltoetsen te zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione ⌘K para pesquisar de qualquer lugar e ⌘N para criar um item. Mantenha ⌘ pressionada para ver todos os atalhos."
          }
        }
      }
    },
