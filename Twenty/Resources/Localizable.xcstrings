    "timeline.opportunity.relatedOnlyLimitation" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen und Aufgaben werden über den verknüpften Kontakt und das Unternehmen geladen. Direkte Opportunity-Verknüpfungen sind für diesen Workspace nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes and tasks are loaded via the linked contact and company. Direct opportunity links are not available for this workspace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas y tareas se cargan a través del contacto y la empresa vinculados. Los vínculos directos con oportunidades no están disponibles en este espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes et tâches sont chargées via le contact et l’entreprise liés. Les liens directs vers l’opportunité ne sont pas disponibles pour cet espace de travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note e attività vengono caricate tramite il contatto e l'azienda collegati. I collegamenti diretti alle opportunità non sono disponibili per questo workspace."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notities en taken worden geladen via het gekoppelde contact en bedrijf. Directe kanskoppelingen zijn voor deze workspace niet beschikbaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notas e tarefas são carregadas por meio do contato e da empresa vinculados. Os vínculos diretos com oportunidades não estão disponíveis neste espaço de trabalho."
          }
        }
      }
    },
