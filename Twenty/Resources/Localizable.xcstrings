    "voiceNote.error.onDeviceUnsupported" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti transkribiert Sprachnotizen nur auf diesem Gerät, und für %@ ist die Spracherkennung auf diesem Gerät nicht verfügbar. Es wurde nichts aufgenommen. Um Sprachnotizen zu nutzen, fügen Sie unter Einstellungen › Allgemein › Tastatur › Diktiersprachen eine unterstützte Sprache hinzu oder stellen Sie Ihr iPhone oder iPad auf eine Sprache um, die Diktieren auf dem Gerät unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti transcribes voice notes only on this device, and on-device recognition isn't available for %@ here. Nothing was recorded. To use voice notes, add a supported language under Settings › General › Keyboard › Dictation Languages, or switch your iPhone or iPad to a language that supports on-device dictation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti transcribe las notas de voz solo en este dispositivo, y el reconocimiento en el dispositivo no está disponible aquí para %@. No se ha grabado nada. Para usar notas de voz, añade un idioma compatible en Ajustes › General › Teclado › Idiomas de dictado, o cambia tu iPhone o iPad a un idioma que admita el dictado en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti transcrit les notes vocales uniquement sur cet appareil, et la reconnaissance sur l’appareil n’est pas disponible ici pour %@. Rien n’a été enregistré. Pour utiliser les notes vocales, ajoutez une langue prise en charge dans Réglages › Général › Clavier › Langues de dictée, ou passez votre iPhone ou iPad à une langue qui prend en charge la dictée sur l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti trascrive le note vocali solo su questo dispositivo e qui il riconoscimento sul dispositivo non è disponibile per %@. Non è stato registrato nulla. Per usare le note vocali, aggiungere una lingua supportata in Impostazioni › Generali › Tastiera › Lingue dettatura oppure impostare iPhone o iPad su una lingua che supporta la dettatura sul dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti zet spraaknotities alleen op dit apparaat om naar tekst, en herkenning op het apparaat is hier niet beschikbaar voor %@. Er is niets opgenomen. Om spraaknotities te gebruiken, voegt u een ondersteunde taal toe via Instellingen › Algemeen › Toetsenbord › Dicteertalen, of stelt u uw iPhone of iPad in op een taal die dicteren op het apparaat ondersteunt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti transcreve notas de voz apenas neste dispositivo, e o reconhecimento no dispositivo não está disponível aqui para %@. Nada foi gravado. Para usar notas de voz, adicione um idioma compatível em Ajustes › Geral › Teclado › Idiomas de Ditado ou mude o iPhone ou iPad para um idioma compatível com o ditado no dispositivo."
          }
        }
      }
    },
