          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de crear un nuevo contacto o una nueva empresa, Viginti busca en el espacio de trabajo registros existentes con el mismo correo electrónico, número de teléfono, dominio o nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
