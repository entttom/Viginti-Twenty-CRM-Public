        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filters voor alleen eigen kansen en kansen zonder volgende activiteit hebben gegevens over de huidige gebruiker en kansactiviteit nodig die lokaal nog niet beschikbaar zijn."
