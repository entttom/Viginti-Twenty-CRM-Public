    "scanner.cameraDenied.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti hat keinen Zugriff auf die Kamera. Um Visitenkarten zu scannen, erlauben Sie den Kamerazugriff für Viginti in den Einstellungen. Sie können weiterhin ein Foto aus Ihrer Mediathek auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti has no access to the camera. To scan business cards, allow camera access for Viginti in Settings. You can still choose a photo from your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti no tiene acceso a la cámara. Para escanear tarjetas de visita, permite el acceso a la cámara para Viginti en Ajustes. Puedes seguir eligiendo una foto de tu fototeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti n’a pas accès à l’appareil photo. Pour scanner des cartes de visite, autorisez l’accès à l’appareil photo pour Viginti dans Réglages. Vous pouvez toujours choisir une photo dans votre photothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti non ha accesso alla fotocamera. Per scansionare i biglietti da visita, consentire l'accesso alla fotocamera per Viginti in Impostazioni. È comunque possibile scegliere una foto dalla libreria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti heeft geen toegang tot de camera. Sta in Instellingen cameratoegang toe voor Viginti om visitekaartjes te scannen. U kunt nog steeds een foto uit uw bibliotheek kiezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti não tem acesso à câmera. Para escanear cartões de visita, permita o acesso à câmera para o Viginti em Ajustes. Você ainda pode escolher uma foto da sua fototeca."
          }
        }
      }
    },
