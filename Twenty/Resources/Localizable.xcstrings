          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Owned-only and no-next-activity filters need current-user and opportunity activity data that is not available locally yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los filtros de solo propias y de sin próxima actividad necesitan datos del usuario actual y de la actividad de las oportunidades que aún no están disponibles localmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
