    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - NSCalendarsFullAccessUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti trägt Ihre Aufgaben auf Wunsch in Ihren Kalender ein und hält die verknüpften Ereignisse aktuell. Wenn Sie die Terminvorbereitung aktivieren, liest Viginti Ihre anstehenden Termine auf diesem Gerät, um passende CRM-Kontakte anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti adds your tasks to your calendar and keeps the linked events in sync when you ask it to. If you turn on meeting preparation, Viginti reads your upcoming events on this device to show matching CRM contacts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti añade tus tareas al calendario y mantiene sincronizados los eventos vinculados cuando lo pides. Si activas la preparación de reuniones, Viginti lee tus próximos eventos en este dispositivo para mostrar los contactos del CRM coincidentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti ajoute vos tâches à votre calendrier et synchronise les événements liés lorsque vous le demandez. Si vous activez la préparation des réunions, Viginti lit vos prochains événements sur cet appareil pour afficher les contacts CRM correspondants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti aggiunge le attività al calendario e mantiene sincronizzati gli eventi collegati quando richiesto. Se la preparazione delle riunioni è attiva, Viginti legge su questo dispositivo i prossimi eventi per mostrare i contatti del CRM corrispondenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti voegt uw taken toe aan uw agenda en houdt de gekoppelde afspraken gesynchroniseerd wanneer u dat vraagt. Als u afspraakvoorbereiding inschakelt, leest Viginti uw komende afspraken op dit apparaat om bijbehorende CRM-contacten te tonen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti adiciona suas tarefas ao calendário e mantém os eventos vinculados sincronizados quando você pede. Se você ativar a preparação para reuniões, o Viginti lê seus próximos eventos neste dispositivo para mostrar os contatos do CRM correspondentes."
          }
        }
      }
    },
    "NSCalendarsUsageDescription" : {
