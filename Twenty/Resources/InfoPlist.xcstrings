    "NSCalendarsWriteOnlyAccessUsageDescription" : {
      "comment" : "Privacy - NSCalendarsWriteOnlyAccessUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti trägt Ihre Aufgaben als Ereignisse in Ihren Kalender ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti adds your tasks to your calendar as events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti añade tus tareas a tu calendario como eventos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti ajoute vos tâches à votre calendrier sous forme d’événements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti aggiunge le attività al calendario come eventi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti voegt uw taken als afspraken toe aan uw agenda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti adiciona suas tarefas ao calendário como eventos."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - NSCameraUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti verwendet die Kamera, um Visitenkarten zu scannen und daraus Kontakte anzulegen sowie Dokumente zu scannen, die Sie an Datensätze anhängen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti uses the camera to scan business cards and create contacts from them, and to scan documents you attach to records."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti usa la cámara para escanear tarjetas de visita y crear contactos a partir de ellas, y para escanear los documentos que adjuntas a los registros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti utilise l’appareil photo pour scanner des cartes de visite et en créer des contacts, ainsi que pour scanner les documents que vous joignez aux enregistrements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti usa la fotocamera per scansionare i biglietti da visita e creare contatti, e per scansionare i documenti allegati ai record."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti gebruikt de camera om visitekaartjes te scannen en er contacten van te maken, en om documenten te scannen die u aan records toevoegt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti usa a câmera para escanear cartões de visita e criar contatos a partir deles, e para escanear documentos que você anexa aos registros."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Privacy - NSContactsUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti fügt einen CRM-Kontakt zu Ihren iOS-Kontakten hinzu, wenn Sie dies auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti adds a CRM contact to your iOS Contacts when you choose to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti añade un contacto del CRM a tus Contactos de iOS cuando así lo eliges."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti ajoute un contact CRM à vos Contacts iOS lorsque vous le choisissez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti aggiunge un contatto del CRM ai contatti iOS quando viene richiesto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti voegt een CRM-contact toe aan uw iOS-contacten wanneer u dat kiest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti adiciona um contato do CRM aos seus Contatos do iOS quando você escolhe."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - NSLocationWhenInUseUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti verwendet Ihren Standort nur, während Sie die Karte nutzen, um Firmen und Kontakte in Ihrer Nähe anzuzeigen. Ihr Standort verlässt dieses Gerät nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti uses your location only while you use the map, to show companies and contacts near you. Your location stays on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti usa tu ubicación solo mientras utilizas el mapa, para mostrar empresas y contactos cercanos. Tu ubicación no sale de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti utilise votre position uniquement pendant que vous utilisez la carte, pour afficher les entreprises et les contacts à proximité. Votre position reste sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti usa la tua posizione solo mentre utilizzi la mappa, per mostrare aziende e contatti nelle vicinanze. La tua posizione resta su questo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti gebruikt uw locatie alleen terwijl u de kaart gebruikt, om bedrijven en contacten in de buurt te tonen. Uw locatie blijft op dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti usa sua localização somente enquanto você usa o mapa, para mostrar empresas e contatos próximos. Sua localização permanece neste dispositivo."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - NSMicrophoneUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti nimmt nur dann Audio auf, wenn Sie eine Sprachnotiz starten, und transkribiert sie auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti records audio only when you start a voice note so it can transcribe your note on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti graba audio solo cuando inicias una nota de voz, para poder transcribirla en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti n’enregistre le son que lorsque vous démarrez une note vocale, afin de la transcrire sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti registra l'audio solo quando si avvia una nota vocale, per poterla trascrivere su questo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti neemt alleen audio op wanneer u een spraaknotitie start, zodat uw notitie op dit apparaat kan worden getranscribeerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti grava áudio somente quando você inicia uma nota de voz, para transcrevê-la neste dispositivo."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - NSPhotoLibraryUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti verwendet Ihre Fotomediathek, um ausgewählte Visitenkartenbilder zu importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti uses your photo library to import business card images you select."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti usa tu fototeca para importar las imágenes de tarjetas de visita que selecciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti utilise votre photothèque pour importer les images de cartes de visite que vous sélectionnez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti usa la libreria foto per importare le immagini di biglietti da visita selezionate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti gebruikt uw fotobibliotheek om afbeeldingen van visitekaartjes te importeren die u selecteert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti usa sua fototeca para importar as imagens de cartões de visita que você selecionar."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - NSSpeechRecognitionUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti verwendet die Spracherkennung von Apple, um Ihre Sprachnotizen zu transkribieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti uses Apple speech recognition to transcribe voice notes you record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti usa el reconocimiento de voz de Apple para transcribir las notas de voz que grabas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti utilise la reconnaissance vocale d’Apple pour transcrire les notes vocales que vous enregistrez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti usa il riconoscimento vocale di Apple per trascrivere le note vocali registrate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viginti gebruikt Apple-spraakherkenning om spraaknotities die u opneemt te transcriberen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Viginti usa o reconhecimento de fala da Apple para transcrever as notas de voz que você grava."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
