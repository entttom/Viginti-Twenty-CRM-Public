    "watch.noData.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr nächstes Meeting und die heutigen Aufgaben erscheinen hier, sobald Viginti auf Ihrem iPhone sie gesendet hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your next meeting and today's tasks appear here once Viginti on your iPhone has sent them."
